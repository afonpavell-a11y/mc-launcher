{
  "name": "mcatlauncher",
  "version": "1.0.2",
  "description": "Modern Minecraft Launcher with Cat",
  "main": "./out/main/index.js",
  "author": "you",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.453.0",
    "node-forge": "^1.3.1",
    "skinview3d": "^3.1.0",
    "three": "^0.169.0",
    "unzipper": "^0.12.5",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.mcatlauncher.app",
    "productName": "MCatLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MCatLauncher"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "afonpavell-a11y",
        "repo": "mc-launcher"
      }
    ]
  }
}
